"use client";

import { motion } from "framer-motion";
import {
  SiNextdotjs,
  SiReact,
  SiTypescript,
  SiNestjs,
  SiNodedotjs,
  SiPostgresql,
  SiDocker,
  SiGit,
  SiLinux,
} from "react-icons/si";
import { technologies } from "@/lib/config";

// Map each technology to its icon and its official brand colour
const techMap: Record<string, { icon: any; color: string }> = {
  "Next.js": { icon: SiNextdotjs, color: "#ffffff" },       // white
  React: { icon: SiReact, color: "#61DAFB" },                // React blue
  TypeScript: { icon: SiTypescript, color: "#3178C6" },      // TS blue
  NestJS: { icon: SiNestjs, color: "#E0234E" },              // Nest red
  "Node.js": { icon: SiNodedotjs, color: "#5FA04E" },        // Node green
  PostgreSQL: { icon: SiPostgresql, color: "#4169E1" },      // Postgres blue
  Docker: { icon: SiDocker, color: "#2496ED" },              // Docker blue
  Git: { icon: SiGit, color: "#F05032" },                    // Git orange
  Linux: { icon: SiLinux, color: "#FCC624" },                // Linux yellow
};

const container = {
  hidden: { opacity: 0 },
  show: {
    opacity: 1,
    transition: {
      staggerChildren: 0.1,
      delayChildren: 0.2,
    },
  },
};

const item = {
  hidden: { opacity: 0, y: 10 },
  show: { opacity: 1, y: 0 },
};

export default function TechStrip() {
  return (
    <section id="tech-strip" className="py-8 border-y border-border bg-secondary/20">
      <div className="container mx-auto px-4 sm:px-6 lg:px-8">
        <motion.div
          variants={container}
          initial="hidden"
          whileInView="show"
          viewport={{ once: true }}
          className="flex flex-wrap items-center justify-center gap-6 md:gap-10"
        >
          {technologies.map((tech) => {
            const entry = techMap[tech];
            const Icon = entry?.icon;
            const color = entry?.color ?? "currentColor";
            return (
              <motion.div
                key={tech}
                variants={item}
                className="flex items-center gap-2 text-muted-foreground text-sm font-medium"
              >
                {Icon && <Icon className="w-5 h-5" style={{ color }} />}
                <span>{tech}</span>
              </motion.div>
            );
          })}
        </motion.div>
      </div>
    </section>
  );
}
