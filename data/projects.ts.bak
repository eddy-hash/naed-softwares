// data/projects.ts

export type ProjectStatus = "live" | "development" | "concept";

export type Project = {
  slug: string;
  title: string;
  description: string;
  category: string;
  status: ProjectStatus;
  technologies: string[];
  image: string;
  features: string[];
  liveUrl?: string;
};

